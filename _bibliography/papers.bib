@mastersthesis{kim2026coxgat,
  title     = {Graph Attention Neural Networks for Survival Analysis of Default in Peer-to-Peer Lending},
  author    = {Kim, Min-seok and Lee, Jooyoung},
  school    = {Chung-Ang University},
  year      = {2026},
  selected  = {true},
  abbr      = {M.S. Thesis},
  bibtex_show = {true},
  abstract  = {This study proposes CoxGAT, a graph attention network-based survival model for predicting time-to-default in P2P lending. By constructing a mutual KNN borrower graph and integrating attention-based message passing with Cox partial likelihood optimization, CoxGAT achieves a C-index of 0.705, outperforming CoxPH (0.550), RSF (0.688), and CoxMLP (0.693). The results demonstrate that financial risk is shaped not only by individual borrower attributes but also by relational structures among borrowers with similar characteristics.}
}
@article{kim2024flood,
  title     = {Modeling for Flood Prediction: Diverse Applications and Evaluation
